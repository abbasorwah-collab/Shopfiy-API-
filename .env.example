# Your store's myshopify domain, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API access token from a custom app (starts with shpat_)
SHOPIFY_ADMIN_TOKEN=
# Admin API version
SHOPIFY_API_VERSION=2025-10
PORT=3000

# --- Live inventory monitor ---
# Secret used to verify webhook signatures (the app's "Client secret")
SHOPIFY_WEBHOOK_SECRET=
# Public https URL of this service, used only by `npm run register-webhooks`
PUBLIC_URL=
# How often to re-sync everything from Shopify as a safety net
POLL_INTERVAL_SECONDS=60
# Items at or below this quantity are flagged "low"
LOW_STOCK_THRESHOLD=5
